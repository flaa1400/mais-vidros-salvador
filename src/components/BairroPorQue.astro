---
import { Image } from 'astro:assets';
import { SITE_CONFIG } from '../data/config';
import trabalhadorVidros from '../assets/trabalhador_vidros.png';

interface Props {
  bairroName: string;
  preposicao: string;
  introText: string;
  demandsList: string[];
}

const { bairroName, preposicao, introText, demandsList } = Astro.props;
---

<section class="bg-gradient-to-br from-secondary to-blue-950 text-white relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-5"></div>
  <div class="container mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Texto Coluna -->
      <div class="lg:col-span-7 space-y-8">
        <h2 class="text-4xl md:text-6xl font-black leading-tight tracking-tighter">
          Por que somos a melhor <br class="hidden md:block" />
          <span class="text-primary italic">Vidraçaria {preposicao} {bairroName}, Salvador-BA?</span>
        </h2>
        
        <p class="text-lg md:text-xl text-blue-100 font-medium leading-relaxed" set:html={introText}></p>

        <div class="inline-flex items-center gap-3 bg-[#1E3A8A]/30 backdrop-blur-md border border-white/10 px-5 py-3.5 rounded-2xl text-white font-bold text-base max-w-full">
          <span class="text-xl">⚡</span>
          <span>Atendimento ágil de Vidraçaria perto de você!</span>
        </div>

        <div class="space-y-6 text-gray-300 text-lg leading-relaxed font-medium">
          {demandsList.map(p => (
            <p set:html={p}></p>
          ))}
        </div>

        <div class="pt-4">
          <a href={`https://wa.me/${SITE_CONFIG.nap.whatsapp}?text=${encodeURIComponent(SITE_CONFIG.nap.whatsappMessage + ' no bairro ' + bairroName)}`} target="_blank" class="inline-flex items-center gap-3 bg-white text-secondary px-8 py-5 rounded-full font-bold text-lg hover:scale-105 active:scale-95 transition-all shadow-xl">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.387a12.035 12.035 0 01-7.108-7.108c-.155-.44.01-9.27.386-9.27l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>Solicite seu Orçamento</span>
          </a>
        </div>
      </div>

      <!-- Imagem Coluna -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="rounded-[2rem] overflow-hidden shadow-2xl w-full max-w-md aspect-[4/3] relative">
          <Image 
            src={trabalhadorVidros} 
            alt={`Instalação de vidraçaria perto de mim ${preposicao} ${bairroName}`} 
            class="w-full h-full object-cover"
            loading="lazy" 
          />
        </div>
      </div>
    </div>
  </div>
</section>
