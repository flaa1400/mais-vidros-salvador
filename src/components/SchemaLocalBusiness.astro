---
import { SITE_CONFIG } from '../data/config';

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": SITE_CONFIG.nap.name,
  "image": `${SITE_CONFIG.url}/logo.png`,
  "@id": SITE_CONFIG.url,
  "url": SITE_CONFIG.url,
  "telephone": SITE_CONFIG.nap.phone,
  "priceRange": "$$",
  "sameAs": [
    SITE_CONFIG.social.instagram,
    SITE_CONFIG.social.facebook,
    "https://x.com/MaisVidros"
  ].filter(Boolean),
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE_CONFIG.nap.address.split(' - ')[0],
    "addressLocality": "Salvador",
    "addressRegion": "BA",
    "postalCode": "41225-000",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -12.9228472,
    "longitude": -38.4503953
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "opens": "08:30",
    "closes": "18:00"
  }
};
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

{isHome && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
