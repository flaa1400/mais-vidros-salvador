---
import { getPreposicaoDe } from '../data/bairros';

interface Props {
  bairroName: string;
  preposicao: string;
}

const { bairroName, preposicao } = Astro.props;
const prepDe = getPreposicaoDe(bairroName);
---

<section class="bg-slate-50 py-24 md:py-32 border-t border-b border-gray-100">
  <div class="container mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-20">
      <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 tracking-tighter leading-tight">
        Vantagens de contratar uma vidraçaria <br class="hidden md:block" />
        <span class="text-secondary">{preposicao} {bairroName}, Salvador-BA próxima de mim</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 font-medium leading-relaxed">
        Escolher um fornecedor local faz toda a diferença na velocidade, custo e suporte da sua obra.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Card 1: Atendimento Rápido -->
      <div class="bg-[#F4F7FC] p-8 md:p-10 rounded-[2rem] border border-blue-50/50 flex flex-col items-center text-center hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-[#E1ECFB] text-[#0052CC] rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Atendimento rápido</h3>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed font-medium">
          Realizamos visitas técnicas e orçamentos com agilidade {preposicao} {bairroName} para sua obra ou reforma.
        </p>
      </div>
      
      <!-- Card 2: Vidro de Qualidade -->
      <div class="bg-[#F4F7FC] p-8 md:p-10 rounded-[2rem] border border-blue-50/50 flex flex-col items-center text-center hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-[#E1ECFB] text-[#0052CC] rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12a3 3 0 116 0 3 3 0 01-6 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12 5.25a6.75 6.75 0 100 13.5 6.75 6.75 0 000-13.5z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Vidro de qualidade</h3>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed font-medium">
          Trabalhamos com vidros temperados de fabricantes reconhecidos, com garantia {preposicao} {bairroName}.
        </p>
      </div>
      
      <!-- Card 3: Instalação Profissional -->
      <div class="bg-[#F4F7FC] p-8 md:p-10 rounded-[2rem] border border-blue-50/50 flex flex-col items-center text-center hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-[#E1ECFB] text-[#0052CC] rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.43l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.991l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128c.332-.183.582-.495.645-.869L9.594 3.94z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Instalação profissional</h3>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed font-medium">
          Equipe especializada em fixação, vedação e acabamento de vidros sob medida para sua obra {preposicao} {bairroName}.
        </p>
      </div>
      
      <!-- Card 4: Compromisso e Garantia -->
      <div class="bg-[#F4F7FC] p-8 md:p-10 rounded-[2rem] border border-blue-50/50 flex flex-col items-center text-center hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-[#E1ECFB] text-[#0052CC] rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Compromisso e garantia</h3>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed font-medium">
          Oferecemos garantia nos serviços realizados e suporte sempre que necessário para sua obra {preposicao} {bairroName}.
        </p>
      </div>
    </div>
  </div>
</section>
