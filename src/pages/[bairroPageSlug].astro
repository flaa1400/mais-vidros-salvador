---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
import { getBairroFormatado, getBairroFormatadoDe } from '../data/bairros';
import { getCollection } from 'astro:content';
import FAQ from '../components/FAQ.astro';
import BairroPorQue from '../components/BairroPorQue.astro';
import BairroVantagens from '../components/BairroVantagens.astro';
import BairroServices from '../components/BairroServices.astro';

export async function getStaticPaths() {
  const bairrosEntries = await getCollection('bairros');
  return bairrosEntries.map(entry => ({
    params: { bairroPageSlug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, bairroName, preposicao, layoutStyle } = entry.data;

const bairroFormatado = getBairroFormatado(bairroName);
const bairroFormatadoDe = getBairroFormatadoDe(bairroName);
const allServices = await getCollection('servicos');
const services = bairroName === 'Lauro de Freitas' ? allServices : allServices.slice(0, 6);

const heroTitle = `Vidraçaria ${bairroFormatado} | Salvador-BA`;
const heroDesc = `Procurando a vidraçaria mais próxima ${bairroFormatado} em Salvador-BA? Somos especialistas em box para banheiro, espelhos sob medida e instalação de vidros temperados.`;
const ctaTitle = `Solicite seu Orçamento ${bairroFormatado}`;
const ctaDesc = `Não feche seu projeto ${bairroFormatadoDe} sem antes falar com a nossa equipe. Receba uma estimativa de custos rápida e sem compromisso via WhatsApp.`;

// Parse markdown body to extract neighborhood-specific paragraphs
const parsedBody: Record<string, string[]> = {};
const normalizedBody = entry.body.replace(/\r\n/g, '\n');
const bodyParts = normalizedBody.split(/\n##\s+/);

for (const part of bodyParts) {
  const lines = part.split('\n');
  const sectionTitle = lines[0].trim();
  const contentLines = lines.slice(1);
  const paragraphs = contentLines.join('\n')
    .split(/\n\s*\n/)
    .map(p => p.trim())
    .filter(p => p.length > 0 && !p.startsWith('---'));
  
  if (sectionTitle) {
    parsedBody[sectionTitle.toLowerCase()] = paragraphs;
  }
}

function getSectionParagraphs(keyword: string): string[] {
  const matchedKey = Object.keys(parsedBody).find(k => k.includes(keyword.toLowerCase()));
  return matchedKey ? parsedBody[matchedKey] : [];
}

const introParagraphs = getSectionParagraphs("atendimento");
const demandsParagraphs = getSectionParagraphs("demandas");

// Format markdown bolding (**text**) to HTML (<strong>text</strong>)
const toHtml = (text: string) => text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

const defaultIntro = `Precisando de uma vidraçaria especializada ${bairroFormatado}? Atuamos com rapidez na fabricação e instalação de vidros temperados, oferecendo atendimento confiável, projeto detalhado e preços justos.`;
const defaultDemands = [
  `Trabalhamos com instalação e manutenção de box de vidro para banheiro, portas em vidro temperado, guarda-corpo, janelas de correr, fachadas de lojas, espelhos sob medida (comuns, lapidados e bisotados), divisórias de vidro, coberturas de vidro e esquadrias de alumínio em residências, escritórios, comércios e condomínios ${bairroFormatadoDe}.`,
  `Nossa equipe de instaladores certificados está pronta para realizar visitas técnicas de medição e apresentar orçamentos sem compromisso. Executamos cada projeto de vidro temperado e esquadrias com acabamento profissional impecável e durabilidade.`
];

const introText = introParagraphs.length > 0 ? toHtml(introParagraphs[0]) : defaultIntro;
const rawDemands = demandsParagraphs.length > 0 ? demandsParagraphs.map(toHtml) : defaultDemands.map(toHtml);

// Limit total text in this section to a maximum of 1400 characters
let totalChars = introText.replace(/<[^>]*>/g, '').length; // Measure clean text length
const demandsList: string[] = [];

for (const p of rawDemands) {
  const cleanP = p.replace(/<[^>]*>/g, '');
  if (totalChars + cleanP.length <= 1400) {
    demandsList.push(p);
    totalChars += cleanP.length;
  } else {
    const remainingBudget = 1400 - totalChars;
    if (remainingBudget > 100) {
      let truncated = p.slice(0, remainingBudget - 3);
      const lastSpace = truncated.lastIndexOf(' ');
      if (lastSpace > 0) {
        truncated = truncated.slice(0, lastSpace);
      }
      demandsList.push(truncated + '...');
      totalChars += truncated.replace(/<[^>]*>/g, '').length + 3;
    }
    break;
  }
}
---

<Layout title={title} description={description}>
	<main>
		<!-- HERO SECTION -->
		<section class="min-h-[70vh] flex items-center bg-gradient-to-br from-white to-gray-50 border-b border-gray-100 overflow-hidden">
			<div class="container mx-auto">
				<div class="max-w-4xl">
					<span class="inline-block px-4 py-2 bg-primary text-secondary font-black text-xs md:text-sm uppercase tracking-[0.2em] rounded-lg mb-8 shadow-md">
						Atendimento {bairroName}
					</span>
					<h1 class="text-5xl md:text-7xl font-black text-gray-900 leading-[1.1] mb-8 tracking-tighter">
						{heroTitle}
					</h1>
					<p class="text-lg md:text-xl text-gray-600 max-w-2xl leading-relaxed mb-12 font-medium">
						{heroDesc}
					</p>
					
					<div class="flex flex-wrap gap-6">
						<a href={`https://wa.me/${SITE_CONFIG.nap.whatsapp}?text=${encodeURIComponent(SITE_CONFIG.nap.whatsappMessage + ' no bairro ' + bairroName)}`} target="_blank" class="bg-secondary text-white px-10 py-6 rounded-2xl font-black text-xl hover:scale-105 active:scale-95 transition-all shadow-2xl shadow-secondary/20 flex items-center gap-4">
							Orçamento no WhatsApp <span>📱</span>
						</a>
						<a href="/servicos/" class="bg-white/80 backdrop-blur-md border-4 border-white text-gray-900 px-10 py-6 rounded-2xl font-black text-xl hover:border-primary hover:scale-105 active:scale-95 transition-all shadow-xl">
							Nossos Serviços
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- LAYOUT STYLE 1 -->
		{layoutStyle === 'layout-1' && (
			<>
				<BairroPorQue bairroName={bairroName} preposicao={preposicao} introText={introText} demandsList={demandsList} />
				<BairroVantagens bairroName={bairroName} preposicao={preposicao} />
				<BairroServices bairroName={bairroName} bairroFormatado={bairroFormatado} services={services} />
				<FAQ bairroName={bairroName} preposicao={preposicao} />
			</>
		)}

		<!-- LAYOUT STYLE 2 -->
		{layoutStyle === 'layout-2' && (
			<>
				<BairroVantagens bairroName={bairroName} preposicao={preposicao} />
				<BairroServices bairroName={bairroName} bairroFormatado={bairroFormatado} services={services} />
				<BairroPorQue bairroName={bairroName} preposicao={preposicao} introText={introText} demandsList={demandsList} />
				<FAQ bairroName={bairroName} preposicao={preposicao} />
			</>
		)}

		<!-- LAYOUT STYLE 3 -->
		{layoutStyle === 'layout-3' && (
			<>
				<BairroServices bairroName={bairroName} bairroFormatado={bairroFormatado} services={services} />
				<BairroPorQue bairroName={bairroName} preposicao={preposicao} introText={introText} demandsList={demandsList} />
				<BairroVantagens bairroName={bairroName} preposicao={preposicao} />
				<FAQ bairroName={bairroName} preposicao={preposicao} />
			</>
		)}

		<!-- LAYOUT STYLE 4 -->
		{layoutStyle === 'layout-4' && (
			<>
				<BairroPorQue bairroName={bairroName} preposicao={preposicao} introText={introText} demandsList={demandsList} />
				<BairroServices bairroName={bairroName} bairroFormatado={bairroFormatado} services={services} />
				<FAQ bairroName={bairroName} preposicao={preposicao} />
				<BairroVantagens bairroName={bairroName} preposicao={preposicao} />
			</>
		)}

		<!-- CTA FINAL LOCALIZADO -->
		<section class="bg-primary">
			<div class="container mx-auto text-center">
				<h2 class="text-4xl md:text-6xl font-black text-secondary leading-tight mb-12 tracking-tighter">
					{ctaTitle}
				</h2>
				<p class="text-xl md:text-2xl text-secondary opacity-90 max-w-3xl mx-auto mb-16 font-bold leading-relaxed uppercase tracking-widest">
					{ctaDesc}
				</p>
				<div class="flex justify-center">
					<a href={`https://wa.me/${SITE_CONFIG.nap.whatsapp}?text=${encodeURIComponent(SITE_CONFIG.nap.whatsappMessage + ' no bairro ' + bairroName)}`} target="_blank" class="bg-secondary text-white px-10 py-7 md:px-12 md:py-8 rounded-[2.5rem] font-black text-2xl hover:scale-110 active:scale-95 transition-all shadow-2xl flex items-center justify-center text-center gap-4 max-w-full">
						Solicitar Orçamento agora <span>📱</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
